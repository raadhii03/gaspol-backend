generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Spbu {
  id        Int      @id @default(autoincrement())
  nama      String
  alamat    String
  kota      String
  latitude  Float
  longitude Float
  status    Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}